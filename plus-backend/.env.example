# ── خادم المحاسبي Plus ─────────────────────────────────────────────
# انسخ هذا الملف إلى .env في بيئة التطوير المحلي.

# المنفذ (افتراضي 4000)
PORT=4000

# ── قاعدة البيانات ────────────────────────────────────────────────
# بدون أي إعداد: يُستخدم ملف SQLite محلي في data/plus_erp.sqlite
# وهذا كافٍ للتطوير المحلي.

# ── Turso (مطلوب في الإنتاج لجعل البيانات دائمة) ──────────────────
# أنشئ قاعدة على https://turso.tech ثم:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
#
# عند ضبط المتغيّرين يعمل التطبيق بنمط النسخة المتماثلة:
# القراءة والكتابة محلياً (سريعة) مع مزامنة دائمة إلى Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# مسار ملف SQLite المحلي (اختياري)
# PLUS_DB_PATH=./data/plus_erp.sqlite
