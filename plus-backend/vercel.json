{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{sql/**,node_modules/@libsql/**,node_modules/libsql/**,node_modules/@neon-rs/**,node_modules/detect-libc/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
