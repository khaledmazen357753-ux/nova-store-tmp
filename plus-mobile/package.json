{
  "name": "plus-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "المحاسبي Plus — تطبيق الجوال الأصلي (Android + iOS) لوحدات المحاسبين وبوابة مدير النظام",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3003",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3003",
    "icons": "node scripts/generate-icons.mjs",
    "android:apk": "npm run build:app && cap sync android && cd android && ./gradlew assembleDebug",
    "ios:sync": "npm run build:app && cap sync ios",
    "build:app": "tsc -b && vite build --mode app",
    "sync:app": "npm run build:app && cap sync",
    "android:bundle": "npm run build:app && cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}